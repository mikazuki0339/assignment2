---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArchiveFeed from '../../components/ArchiveFeed.astro';
import { getPublished } from '../../utils/content';
const entries = await getPublished('news');
---
<BaseLayout title="新闻记录" description="人工选择的新闻线索、个人评论与原始来源。">
  <PageHeader eyebrow="NEWS, SLOWLY / 04" title="新闻，慢慢记" intro="不追逐每一次刷新。只收藏值得稍后重读的事件，并留下它与我的关系。" />
  <section class="container" aria-label="新闻策展列表"><ArchiveFeed entries={entries} /></section>
</BaseLayout>
